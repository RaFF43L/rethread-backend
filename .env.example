PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rethread_dev

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rethread_dev

# ===== AWS =====
# Em desenvolvimento com LocalStack, use as credenciais de teste abaixo e
# aponte AWS_ENDPOINT_URL para o gateway local (http://localhost:4566).
# Em produção, remova AWS_ENDPOINT_URL e AWS_PUBLIC_URL e use credenciais reais.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_PUBLIC_URL=http://localhost:4566/rethread-images

AWS_ACCESS_KEY_ID_COGNITO=test
AWS_SECRET_ACCESS_KEY_COGNITO=test
AWS_ACCESS_KEY_ID_S3=test
AWS_SECRET_ACCESS_KEY_S3=test
AWS_BUCKET_NAME=rethread-images

# ===== AWS Cognito =====
# Em produção, use os valores reais do user pool.
# Com LocalStack Pro/Enterprise, o init gera esses valores no primeiro boot
# (docker compose logs localstack ou localstack/output/.env.localstack).
# Obs.: a edição Community do LocalStack não inclui o serviço Cognito.
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_USER_POOL_ID=

# ===== Login com Google (federação via Cognito) =====
# Domínio do user pool (App integration > Domain), com https://.
# Ex.: https://rethread.auth.us-east-1.amazoncognito.com
COGNITO_DOMAIN=
# Página do front que recebe ?code&state; precisa estar nas "Allowed callback
# URLs" do app client.
COGNITO_OAUTH_REDIRECT_URI=

# ===== AbacatePay =====
# Chave de API (dev mode ou produção) gerada no painel da AbacatePay.
ABACATEPAY_API_KEY=key_CEcuTRxYUTw6QXSZFt2r5kBL

# ===== AI Agent =====
AI_AGENT_URL=http://localhost:3002
